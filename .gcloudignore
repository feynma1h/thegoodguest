# gcloudignore — controls what gcloud builds submit uploads to Cloud Build.
#
# Once this file exists, gcloud no longer falls back to .gitignore, so we
# must explicitly inherit it with the line below, then add extras.
.gitignore

# ── Tracked files not needed in any build ────────────────────────────────────
# Nine synthetic room renders (~720 KB total), used only by
# tools/build_test_bundle.py and regenerable with tools/make_synthetic_photos.py.
# No service Dockerfile COPYs from here, so the build context does not need them.
test_data/

# ── Build / cache artifacts ───────────────────────────────────────────────────
# .gitignore already covers outputs/, .venv/, __pycache__, *.pyc, *.egg-info,
# .pytest_cache, .DS_Store, etc.  List them here too so we stay explicit now
# that the .gitignore fallback is disabled, and to catch anything that slips
# through (e.g. build/ dirs created by pip wheel builds that aren't gitignored).
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/
packages/schemas/build/

# ── Dev-environment directories ───────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Test / lint cache ─────────────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ── Editor / OS noise ─────────────────────────────────────────────────────────
.git/
.DS_Store
Thumbs.db
__MACOSX/
.vscode/
.idea/

# ── Local Claude Code state ───────────────────────────────────────────────────
.claude/

# ── Repo sections never needed in a container build ──────────────────────────
# docs/ is decision notes and workflow docs; no Dockerfile COPYs from it.
docs/

# tools/ is deliberately NOT excluded. It looks like local-only scripting, and
# was excluded on that reasoning, but services/perception-obj/Dockerfile COPYs
# tools/spz_encode.mjs — the SPZ encoder the /compress stage runs, and the one
# the image's build-time smoke exercises. With tools/ excluded, that COPY fails
# and no perception-obj image can be built at all. The whole directory is
# ~300 KB of tracked source, so excluding it saved nothing worth this.
# If a future service needs it out of its context, exclude by file, not by
# directory: a gitignore-style negation cannot re-include a path inside an
# already-excluded directory.

# The web app deploys to Firebase Hosting, not Cloud Run; no service Dockerfile
# COPYs from web/. Its node_modules/ and .next/ are ignored only by the NESTED
# web/.gitignore, which gcloud does not process (only the top-level .gitignore
# is inherited) — without this line they add ~1.3 GiB to every build context.
web/

# ── Generated artifacts ───────────────────────────────────────────────────────
outputs/
