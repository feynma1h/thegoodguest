<?xml version="1.0" encoding="UTF-8"?>
<!--
  The privacy manifest. Required in the app bundle for App Store submission,
  and separate from the App Store Connect nutrition labels — filing the labels
  does not satisfy this, and shipping this does not satisfy the labels. Both
  are required and they must agree.

  THE TRACE FOR EVERY ENTRY BELOW is docs/product/privacy-nutrition-labels.md,
  which reads the live system rather than the policy pages. When a data type
  moves there it moves here in the same commit; a manifest that disagrees with
  the labels is worse than either being wrong alone, because the disagreement
  is what review notices.

  EVERY REASON CODE BELONGS TO ONE CATEGORY. Apple's NSPrivacyAccessedAPIType
  page lists each category's codes, and upload refuses a code that is not
  valid for the category it is declared under (ITMS-91055) however well its
  description reads, because codes from every category look alike. Within a
  category the codes are neighbours with different terms, and upload cannot
  tell whether the one declared is what the app does. So each entry below
  says what its code covers and why the neighbours do not fit, and
  tools/test_privacy_manifest.py checks both halves. Three of the five
  categories are declared; DiskSpace and ActiveKeyboards are absent because
  no API in either category is called anywhere in the app, which is worth
  stating since CaptureRecovery's behaviour makes DiskSpace look likely.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- No tracking, no tracking domains. There is no analytics SDK, no
       advertising SDK, and no crash reporter in this app: the linked package
       set is Firebase and GoogleSignIn only. -->
  <key>NSPrivacyTracking</key><false/>
  <key>NSPrivacyTrackingDomains</key><array/>

  <key>NSPrivacyCollectedDataTypes</key>
  <array>
    <!-- The capture's keyframes. Photographs of the inside of a home, which is
         the most sensitive thing this app handles. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePhotosorVideos</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
    </dict>

    <!-- ARKit/RoomPlan geometry: depth, planes, the measured room. Distinct
         from photographs and declared separately, because a room's shape is
         not a picture of it and Apple gives it its own type. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeEnvironmentScanning</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
    </dict>

    <!-- The Firebase uid. Every scene, conversation and upload session is
         keyed on it, which is exactly what makes everything else Linked. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeUserID</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
    </dict>

    <!-- device_id on the capture bundle: a per-installation identifier, not
         the IDFA and not a hardware id. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeDeviceID</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
    </dict>

    <!-- Name and email arrive only when someone links Apple or Google. An
         anonymous user supplies neither, but the manifest describes what the
         app CAN collect rather than what a given person happened to give. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeName</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
    </dict>
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeEmailAddress</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
    </dict>

    <!-- What a person types to the guest, and the arrangements that come back.
         This is labels §3.1i, the broader of the two judgment calls: declared
         because a sentence about your own home is user content even when the
         app only ever sends words. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeOtherUserContent</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
    </dict>

    <!-- Scene status, failure reasons, and the pipeline's own bookkeeping. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
    </dict>

    <!-- Labels §3.1h, the narrower judgment call: the profile photo URL a
         linked provider hands over. Declared under Other rather than dropped,
         because the conservative reading is the one that cannot be wrong in
         the direction that matters. -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeOtherDataTypes</string>
      <key>NSPrivacyCollectedDataTypeLinked</key><true/>
      <key>NSPrivacyCollectedDataTypeTracking</key><false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
    </dict>
  </array>

  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <!-- UserDefaults.standard: DismissedBundles in BundleRestore (which
         CaptureReaper also reads through) and WhySignInSheet, plus the
         DEBUG-only StagingHooks and ScreenGallery.

         CA92.1 — read and write information that only the app itself can
         access. Every call is on `.standard`, for the app's own keys: there is
         no app-groups entitlement and no UserDefaults(suiteName:), so NOT
         1C8F.1, the App Group reason. -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key><array><string>CA92.1</string></array>
    </dict>

    <!-- CACurrentMediaTime(), in CaptureManager, for elapsed time only.

         35F9.1 — measure the time elapsed between events in the app, or run
         timers; of what is read under it, only elapsed time between in-app
         events may leave the device. Both uses are that. startedAtDeviceUs and
         endedAtDeviceUs bound the capture, and BundleAssembler writes them,
         and every frame timestamp on the same clock, into the uploaded bundle
         counted from capture start, never as the reading itself, which counts
         from boot. publishCameraPlanPose's 20 Hz gate subtracts two readings
         and stays on the device.

         NOT 8FFB.1, which is for computing absolute timestamps of in-app
         events; those may leave the device, but boot time and anything else
         derived from it may not. The bundle's absolute time is
         started_at_wall_us, from Date(). NOT 3D61.1, which is for a bug report
         the person chooses to submit. -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
      <key>NSPrivacyAccessedAPITypeReasons</key><array><string>35F9.1</string></array>
    </dict>

    <!-- CaptureStorageSweeper reads .contentModificationDateKey to age out
         captures under applicationSupportDirectory (.userDomainMask), the app's
         own container.

         C617.1 — timestamps, size or other metadata of files inside the app
         container, app group container or CloudKit container. NOT DDA9.1, which
         is for displaying a file's timestamp to the person using the device,
         and the sweeper displays nothing. NOT 3B52.1, which is for files the
         user granted access to, such as through a document picker. -->
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
      <key>NSPrivacyAccessedAPITypeReasons</key><array><string>C617.1</string></array>
    </dict>
  </array>
</dict>
</plist>
