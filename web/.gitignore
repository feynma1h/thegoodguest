# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# the deploy build's env — committed so `next build` is the hosting artifact
!.env.production

# local dev fixtures (generated by tools/make_synthetic_splat.py)
# No trailing slash: parallel worktrees symlink this path to the main tree
# rather than regenerating it, and a symlink is a file — a directory-only
# pattern leaves it untracked and one `git add -A` from being committed.
/public/dev-fixtures

# firebase hosting cache
.firebase/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# variant-B hero probe: a real object splat is a possession — never shipped
/public/hero/piece.json
/public/hero/*.ply
