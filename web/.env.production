# The deploy build's environment. `next build` runs with NODE_ENV=production
# and reads this file, so a bare `npm run build` from a fresh checkout IS the
# Firebase Hosting artifact: live mode against deployed api-public, signed in
# via the thegoodguest-web Firebase registration (2026-08-31). Committed on
# purpose — nothing here is a secret (see .env.example) — so preview-channel
# deploys are reproducible with zero manual env setup. `next dev` never reads
# this file, and .env.local overrides it for local experiments.
NEXT_PUBLIC_API_MODE=live
NEXT_PUBLIC_API_BASE_URL=https://api-public-o4dhc34kqq-as.a.run.app
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDtTm50WJwiLUtW42ZOMRzFMKvgwWv9AvQ
NEXT_PUBLIC_FIREBASE_PROJECT_ID=thegoodguest
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=thegoodguest.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=1:94380440502:web:398b516b3effe525565f17
