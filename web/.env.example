# Copy to .env.local and adjust. All values are build-time public
# (NEXT_PUBLIC_*) — nothing here is a secret; the Firebase web API key is
# an identifier, not a credential.

# Who serves the app's data (see src/lib/api/index.ts):
#   mock       — offline fixtures, no backend, no auth (default)
#   live-local — local uvicorn api-public on NEXT_PUBLIC_API_BASE_URL with
#                the NullTokenVerifier dev token
#   live       — deployed api-public with Sign in with Apple (decision
#                0051: sign in with the Apple ID linked in the iOS app)
NEXT_PUBLIC_API_MODE=mock

# api-public base URL. live-local default: http://localhost:8080
# Production: https://api-public-q62kcditqa-as.a.run.app
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Firebase (live mode only). Values are the roomstudio-web registration
# (2026-07-22; replaced the roomstudio-smoke-test appId). The committed
# .env.production carries the same values for the deploy build.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyA63NB_KR93h9GDubrNtxYhmpve6vWkkvw
NEXT_PUBLIC_FIREBASE_PROJECT_ID=roomstudio
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=roomstudio.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=1:502805861152:web:f556f8bb331bea1bdcbd45
